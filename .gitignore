/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail

# Frontend
frontend/node_modules
frontend/.next
frontend/out
# Incremental TypeScript build cache — machine-specific, no value in history.
frontend/tsconfig.tsbuildinfo
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db

# Test/debug artifacts
smoke_*.php
check_*.php
db_check.php
debug_*.php
# One-off probes run through artisan tinker or the CLI server.
*_probe.php

# Credentials captured for manual API probing — a plaintext password.
storage/login.json

# Merge leftovers. `*.head` is what a conflicted `git checkout --ours` writes.
*.head

